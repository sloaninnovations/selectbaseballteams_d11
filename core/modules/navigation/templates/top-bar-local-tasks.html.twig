{#
/**
 * @file
 * Default theme implementation for navigation top bar local tasks.
 *
 * Available variables:
 * - local_tasks: Array of local tasks for the current route.
 * - featured_local_task: The local task to show featured before the dropdown.
 */
#}
{% set dropdown_id = 'admin-local-tasks'|clean_unique_id %}

{% if featured_local_task %}
  {#  The featured_local_task.task is a render array and the text passed to the parent
  component needs to be an string. Hence we are rendering the text and passing
  it to the component.#}
  {{ dump(featured_local_task.task) }}
  {% include 'navigation:toolbar-button' with {
    text: featured_local_task.task|render,
    modifiers: ['main-action'],
    icon: featured_local_task.icon,
  } only %}
{% endif %}

{% include 'navigation:toolbar-button' with {
  icon: 'kebab',
  attributes: create_attribute(
    {
      'aria-expanded': 'false',
      'aria-controls': dropdown_id,
      'data-drupal-dropdown': 'true'
    }
  ),
} only %}

<div class="toolbar-dropdown__menu" id={{ dropdown_id }}>
  <ul class="toolbar-dropdown__list">
    {% for local_task in local_tasks %}
      {{ local_task }}
    {% endfor %}
  </ul>
</div>
