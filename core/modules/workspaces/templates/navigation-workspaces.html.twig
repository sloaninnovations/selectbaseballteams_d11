{#
/**
 * @file
 * Default theme implementation to display the workspaces navigation item.
 *
 * Available variables:
 * - title: The label of the active workspace.
 * - attributes: HTML attributes for the navigation item.
 *
 * @ingroup themeable
 */
#}
<div class="admin-toolbar__item">
  <h4 id="navigation-workspaces" class="toolbar-block__title visually-hidden focusable">{{ 'Workspace'|t }}</h4>
  <ul class="toolbar-block__list">
    <li class="toolbar-block__list-item">
      {% include '@navigation/toolbar-button.html.twig' with {
        attributes: attributes.setAttribute('data-drupal-tooltip', title).setAttribute('data-drupal-tooltip-class', 'admin-toolbar__tooltip'),
        icon: 'workspaces',
        html_tag: 'a',
        text: title|t,
      } only %}
    </li>
  </ul>
</div>
