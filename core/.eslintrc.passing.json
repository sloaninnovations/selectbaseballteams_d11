{
  "rules": {
    "no-shadow": "off",
    "no-new": "off",
    "no-continue": "off",
    "new-cap": "off",
    "max-len": [
      "error",
      80,
      {
        "ignoreUrls": true,
        "ignoreComments": false,
        "ignoreRegExpLiterals": true,
        "ignoreStrings": true,
        "ignoreTemplateLiterals": true
      }
    ],
    "default-case": "off",
    "default-param-last": "off",
    "prefer-destructuring": "off",
    "prefer-regex-literals": "off",
    "import/no-import-module-exports": "off"
  }
}
