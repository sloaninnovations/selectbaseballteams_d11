<div{{ attributes.addClass(classes) }}>
  {% if not label_hidden %}
    <h3{{ title_attributes.addClass(title_classes) }}>{{ label }}</h3>
  {% endif %}
  <ul class="links field__items field--tags__items">
    {% for item in items %}
      <li{{ item.attributes.addClass('field--tags__item') }}>{{ item.content }}</li>
    {% endfor %}
  </ul>
</div>
